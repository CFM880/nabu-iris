+    if (s->output_drm) {
+        ret = v4l2_buf_to_bufref_drm(avbuf, &frame->buf[0]);
+        if (!ret) {
+            frame->data[0] = frame->buf[0]->data;
+            frame->format = AV_PIX_FMT_DRM_PRIME;
+            if (!s->frames_ref) {
+                av_frame_unref(frame);
+                return AVERROR(EINVAL);
+            }
+            frame->hw_frames_ctx = av_buffer_ref(s->frames_ref);
+            if (!frame->hw_frames_ctx) {
+                av_frame_unref(frame);
+                return AVERROR(ENOMEM);
+            }
+        }
+    } else {
+        ret = v4l2_buffer_buf_to_swframe(frame, avbuf);
+    }
     if (ret)
         return ret;
 
@@ -572,6 +675,12 @@ int ff_v4l2_buffer_initialize(V4L2Buffer* avbuf, int index)
         avbuf->buf.length    = avbuf->planes[0].length;
     }
 
+    if (buf_to_m2mctx(avbuf)->output_drm) {
+        ret = v4l2_buffer_export_drm(avbuf);
+        if (ret < 0)
+            return ret;
+    }
