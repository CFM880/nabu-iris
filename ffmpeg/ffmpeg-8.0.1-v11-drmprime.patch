+static int v4l2_buffer_export_drm(V4L2Buffer *avbuf)
+{
+    AVDRMFrameDescriptor *desc = &avbuf->drm_frame;
+    AVDRMLayerDescriptor *layer = &desc->layers[0];
+    struct v4l2_exportbuffer expbuf;
+    int i, ret;
+
+    if (avbuf->context->av_pix_fmt != AV_PIX_FMT_NV12)
+        return AVERROR(ENOSYS);
+
+    memset(desc, 0, sizeof(*desc));
+    for (i = 0; i < AV_DRM_MAX_PLANES; i++)
+        desc->objects[i].fd = -1;
+
+    for (i = 0; i < avbuf->num_planes; i++) {
+        memset(&expbuf, 0, sizeof(expbuf));
+        expbuf.type = avbuf->buf.type;
+        expbuf.index = avbuf->buf.index;
+        expbuf.plane = i;
+        expbuf.flags = 0;
+
+        ret = ioctl(buf_to_m2mctx(avbuf)->fd, VIDIOC_EXPBUF, &expbuf);
+        if (ret < 0) {
+            ret = AVERROR(errno);
+            goto fail;
+        }
+
+        if (fcntl(expbuf.fd, F_SETFD, FD_CLOEXEC) < 0) {
+            ret = AVERROR(errno);
+            close(expbuf.fd);
+            goto fail;
+        }
+
+        desc->objects[i].fd = expbuf.fd;
+        desc->objects[i].size = avbuf->plane_info[i].length;
+        desc->objects[i].format_modifier = 0; /* DRM_FORMAT_MOD_LINEAR */
+        desc->nb_objects++;
+    }
+
+    desc->nb_layers = 1;
+    layer->format = V4L2_PIX_FMT_NV12; /* Same fourcc value as DRM_FORMAT_NV12. */
+    layer->nb_planes = 2;
+    layer->planes[0].object_index = 0;
+    layer->planes[0].offset = 0;
+    layer->planes[0].pitch = avbuf->plane_info[0].bytesperline;
+
+    if (avbuf->num_planes > 1) {
+        layer->planes[1].object_index = 1;
+        layer->planes[1].offset = 0;
+        layer->planes[1].pitch = avbuf->plane_info[1].bytesperline;
+    } else {
+        layer->planes[1].object_index = 0;
+        layer->planes[1].offset = avbuf->plane_info[0].bytesperline *
+                                  avbuf->context->format.fmt.pix_mp.height;
+        layer->planes[1].pitch = avbuf->plane_info[0].bytesperline;
+    }
+
+    return 0;
+
+fail:
+    for (i = 0; i < desc->nb_objects; i++) {
+        close(desc->objects[i].fd);
+        desc->objects[i].fd = -1;
+    }
+    desc->nb_objects = 0;
+    return ret;
+}
+
+static int v4l2_buf_to_bufref_drm(V4L2Buffer *in, AVBufferRef **buf)
+{
+    int ret;
+
+    *buf = av_buffer_create((uint8_t *)&in->drm_frame,
+                            sizeof(in->drm_frame), v4l2_free_buffer, in,
+                            AV_BUFFER_FLAG_READONLY);
+    if (!*buf)
+        return AVERROR(ENOMEM);
+
+    ret = v4l2_buf_increase_ref(in);
+    if (ret)
+        av_buffer_unref(buf);
+
+    return ret;
+}
