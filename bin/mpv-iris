#!/bin/sh
set -eu

ffmpeg_prefix="${HOME}/.local/opt/nabu-iris-v140-drmprime-v11/ffmpeg"
libavcodec="${ffmpeg_prefix}/lib/libavcodec.so.62"

if [ ! -r "${libavcodec}" ]; then
    echo "Missing patched FFmpeg library: ${libavcodec}" >&2
    echo "Run install-user.sh from the release directory first." >&2
    exit 1
fi

export LD_LIBRARY_PATH="${ffmpeg_prefix}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

exec /usr/bin/mpv \
    --hwdec=v4l2m2m \
    --hwdec-codecs=h264,hevc \
    --vo=dmabuf-wayland \
    --video-sync=display-resample \
    --interpolation=no \
    "$@"
