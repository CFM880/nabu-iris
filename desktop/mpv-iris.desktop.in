[Desktop Entry]
Type=Application
Name=MPV (Iris hardware decoding)
Name[zh_CN]=MPV（Iris 硬件解码）
Comment=Play H.264, HEVC, and VP9 through the Iris DRM PRIME zero-copy path
Comment[zh_CN]=通过 Iris DRM PRIME 零拷贝路径播放 H.264、HEVC 和 VP9 视频
TryExec=@HOME@/.local/bin/mpv-iris
Exec=@HOME@/.local/bin/mpv-iris --player-operation-mode=pseudo-gui %U
Icon=mpv
Terminal=false
StartupNotify=true
Categories=AudioVideo;Player;
MimeType=video/mp4;video/webm;
Keywords=mpv;video;Iris;hardware decoding;DRM PRIME;
