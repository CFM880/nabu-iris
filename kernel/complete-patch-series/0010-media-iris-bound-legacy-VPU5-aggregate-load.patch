@@ -204,6 +204,7 @@ int iris_vb2_queue_setup(struct vb2_queue *q,
 	struct iris_inst *inst;
 	struct iris_core *core;
 	struct v4l2_format *f;
+	u32 admission_fps;
 	int ret = 0;
 
 	inst = vb2_get_drv_priv(q);
@@ -246,6 +247,10 @@ int iris_vb2_queue_setup(struct vb2_queue *q,
 			ret = -EINVAL;
 		goto unlock;
