 .../qcom/iris/iris_hfi_gen1_response.c        |  40 ++++++-
 .../media/platform/qcom/iris/iris_hfi_queue.c |   2 +-
 .../media/platform/qcom/iris/iris_instance.h  |   6 ++
 drivers/media/platform/qcom/iris/iris_vb2.c   | 100 ++++++++++++++++++
