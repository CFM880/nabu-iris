diff --git a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu.dts b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu.dts
index 864acb55c..6e66713d8 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu.dts
@@ -106,9 +106,14 @@ cdsp_sec_mem: memory@a4c00000 {
 		ramoops@b0000000 {
 			compatible = "ramoops";
 			reg = <0x0 0xb0000000 0x0 0x400000>;
-			record-size = <0x1000>;
-			console-size = <0x200000>;
-			ecc-size = <16>;
+			/*
+			 * Keep the complete printk console across hard resets.  The
+			 * previous 4 KiB records with ECC produced uncorrectable
+			 * headers on every boot and left /sys/fs/pstore empty.
+			*/
+			record-size = <0>;
+			console-size = <0x400000>;
+			ecc-size = <0>;
 			no-map;
 		};
 
@@ -1041,6 +1046,11 @@ bluetooth: bluetooth {
 	};
 };
 
