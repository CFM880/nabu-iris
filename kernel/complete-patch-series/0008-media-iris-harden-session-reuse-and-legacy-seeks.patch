 .../media/platform/qcom/iris/iris_common.h    |   2 +
 .../qcom/iris/iris_hfi_gen1_response.c        |  54 +++++++++
 .../media/platform/qcom/iris/iris_instance.h  |  16 ++-
 drivers/media/platform/qcom/iris/iris_power.c |  20 ++-
 drivers/media/platform/qcom/iris/iris_power.h |   1 +
 drivers/media/platform/qcom/iris/iris_utils.c |   9 +-
 drivers/media/platform/qcom/iris/iris_vb2.c   |  29 +++--
 drivers/media/platform/qcom/iris/iris_vdec.c  | 114 ++++++++++++++++++
 drivers/media/platform/qcom/iris/iris_vdec.h  |   5 +
 drivers/media/platform/qcom/iris/iris_vidc.c  |  42 +------
 11 files changed, 340 insertions(+), 59 deletions(-)

diff --git a/drivers/media/platform/qcom/iris/iris_common.c b/drivers/media/platform/qcom/iris/iris_common.c
index 2dfbff73b..17cbfaa84 100644
--- a/drivers/media/platform/qcom/iris/iris_common.c
+++ b/drivers/media/platform/qcom/iris/iris_common.c
@@ -197,6 +197,105 @@ static void iris_kill_session(struct iris_inst *inst)
 	iris_inst_change_state(inst, IRIS_INST_ERROR);
 }
 
+int iris_hfi_session_open(struct iris_inst *inst)
+{
+	const struct iris_hfi_command_ops *hfi_ops = inst->core->hfi_ops;
+	struct iris_core *core = inst->core;
+	struct iris_inst *instance;
+	u32 active_sessions = 0;
+	int ret;
+
+	if (inst->hfi_session_opened)
+		return 0;
+
+	mutex_lock(&core->lock);
+	list_for_each_entry(instance, &core->instances, list) {
+		if (instance->hfi_session_opened)
+			active_sessions++;
+	}
+
+	if (active_sessions >= core->iris_platform_data->max_session_count) {
+		mutex_unlock(&core->lock);
+		return -EBUSY;
+	}
+
+	/* Reserve the slot before dropping core->lock and issuing SESSION_INIT. */
+	inst->hfi_session_opened = true;
+	mutex_unlock(&core->lock);
+
+	ret = hfi_ops->session_open(inst);
+	if (ret) {
+		/* A timeout leaves firmware ownership uncertain until recovery. */
+		if (inst->state == IRIS_INST_ERROR)
+			return ret;
+		goto release_slot;
+	}
+
+	if (inst->state == IRIS_INST_ERROR)
+		return -EIO;
+
+	ret = iris_inst_change_state(inst, IRIS_INST_INIT);
+	if (ret)
+		return ret;
+
+	return 0;
+
+release_slot:
+	mutex_lock(&core->lock);
+	inst->hfi_session_opened = false;
+	mutex_unlock(&core->lock);
+
+	return ret;
+}
+
+int iris_hfi_session_close(struct iris_inst *inst)
+{
+	const struct iris_hfi_command_ops *hfi_ops = inst->core->hfi_ops;
+	struct iris_core *core = inst->core;
+	bool was_error;
+	int ret, power_ret;
+
+	if (!inst->hfi_session_opened)
+		return 0;
+
+	was_error = inst->state == IRIS_INST_ERROR;
+	reinit_completion(&inst->completion);
+
+	ret = hfi_ops->session_close(inst);
+	if (ret)
+		return ret;
+
+	ret = iris_wait_for_session_response(inst, false);
+	if (ret)
+		return ret;
+
+	if (!was_error && inst->state == IRIS_INST_ERROR)
+		return -EIO;
+
+	if (inst->state != IRIS_INST_ERROR) {
+		ret = iris_inst_change_state(inst, IRIS_INST_DEINIT);
+		if (ret)
+			return ret;
+	}
+
+	mutex_lock(&core->lock);
+	inst->hfi_session_opened = false;
+	mutex_unlock(&core->lock);
+
+	inst->sub_state = 0;
+	inst->streamoff_pending = false;
+	inst->flush_responses_pending = 0;
+	inst->last_buffer_dequeued = false;
+
+	power_ret = iris_unvote_power(inst);
+	if (power_ret)
+		dev_warn(core->dev,
+			 "failed to remove stopped-session power vote: %d\n",
+			 power_ret);
+
+	return 0;
+}
+
 int iris_session_streamoff(struct iris_inst *inst, u32 plane)
 {
 	const struct iris_hfi_command_ops *hfi_ops = inst->core->hfi_ops;
@@ -227,7 +326,7 @@ int iris_session_streamoff(struct iris_inst *inst, u32 plane)
 
 	iris_flush_deferred_buffers(inst, buffer_type);
 
-	if (inst->domain == DECODER && inst->state == IRIS_INST_INIT) {
+	if (inst->state == IRIS_INST_INIT) {
 		ret = iris_destroy_all_internal_buffers(inst,
 						V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
 		if (ret)
@@ -238,8 +337,12 @@ int iris_session_streamoff(struct iris_inst *inst, u32 plane)
 		if (ret)
 			return ret;
 
+		ret = iris_hfi_session_close(inst);
+		if (ret)
+			return ret;
+
 		dev_info(inst->core->dev,
-			 "Iris1 v121: released stopped-session internal DMA buffers\n");
+			 "Iris1 v135: released stopped-session DMA and HFI resources\n");
 	}
 
 	return 0;
diff --git a/drivers/media/platform/qcom/iris/iris_common.h b/drivers/media/platform/qcom/iris/iris_common.h
index b2a27b781..51324039b 100644
--- a/drivers/media/platform/qcom/iris/iris_common.h
+++ b/drivers/media/platform/qcom/iris/iris_common.h
@@ -13,6 +13,8 @@ int iris_vb2_buffer_to_driver(struct vb2_buffer *vb2, struct iris_buffer *buf);
 void iris_set_ts_metadata(struct iris_inst *inst, struct vb2_v4l2_buffer *vbuf);
 int iris_process_streamon_input(struct iris_inst *inst);
 int iris_process_streamon_output(struct iris_inst *inst);
+int iris_hfi_session_open(struct iris_inst *inst);
+int iris_hfi_session_close(struct iris_inst *inst);
 int iris_session_streamoff(struct iris_inst *inst, u32 plane);
 
 #endif
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_gen1_response.c b/drivers/media/platform/qcom/iris/iris_hfi_gen1_response.c
index 647d22b58..7b6d45827 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen1_response.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen1_response.c
@@ -15,6 +15,8 @@
 #include "iris_vdec.h"
 #include "iris_vpu_buffer.h"
 
+#define IRIS1_MAX_CORRUPT_OUTPUT_DROPS 8
+
 static u32
 iris_hfi_gen1_bufreq_count_min(struct iris_inst *inst,
 			       const struct hfi_buffer_requirements *bufreq)
@@ -478,8 +480,11 @@ static void iris_hfi_gen1_session_ftb_done(struct iris_inst *inst, void *packet)
 	u32 offset;
 	u64 timestamp_us = 0;
 	bool m2m_stopped;
+	bool recycle_output = false;
+	bool seek_was_pending = false;
 	bool found = false;
 	u32 flags = 0;
+	int ret;
 
 	if (inst->domain == DECODER) {
 		timestamp_hi = uncom_pkt->time_stamp_hi;
@@ -569,6 +574,45 @@ static void iris_hfi_gen1_session_ftb_done(struct iris_inst *inst, void *packet)
 	}
 	buf->timestamp = timestamp_us;
 
+	if (inst->domain == DECODER && buf->type == BUF_OUTPUT &&
+	    inst->core->iris_platform_data->legacy_vpu5) {
+		ret = iris_vdec_complete_pending_output(inst);
+		if (ret)
+			goto error;
+		seek_was_pending = inst->seek_timestamp_pending;
+	}
+
+	if (inst->domain == DECODER && buf->type == BUF_OUTPUT && filled_len) {
+		if (inst->core->iris_platform_data->legacy_vpu5 &&
+		    (hfi_flags & (HFI_BUFFERFLAG_DATACORRUPT |
+				  HFI_BUFFERFLAG_DROP_FRAME)) &&
+		    inst->corrupt_output_drops < IRIS1_MAX_CORRUPT_OUTPUT_DROPS) {
+			inst->corrupt_output_drops++;
+			recycle_output = true;
+			dev_info(inst->core->dev,
+				 "Iris1 v137: recycling corrupt output timestamp %llu ns flags %#x (drop %u/%u)\n",
+				 timestamp_us, hfi_flags,
+				 inst->corrupt_output_drops,
+				 IRIS1_MAX_CORRUPT_OUTPUT_DROPS);
+		} else {
+			inst->corrupt_output_drops = 0;
+			recycle_output = iris_vdec_discard_stale_frame(inst,
+								timestamp_us);
+		}
+	}
+
+	if (recycle_output) {
+		buf->data_size = 0;
+		buf->flags = 0;
+		buf->timestamp = 0;
+		buf->attr &= ~(BUF_ATTR_QUEUED | BUF_ATTR_DEQUEUED |
+			       BUF_ATTR_BUFFER_DONE);
+		ret = iris_queue_buffer(inst, buf);
+		if (ret)
+			goto error;
+		return;
+	}
+
 	switch (pic_type) {
 	case HFI_GEN1_PICTURE_IDR:
 	case HFI_GEN1_PICTURE_I:
@@ -599,6 +643,16 @@ static void iris_hfi_gen1_session_ftb_done(struct iris_inst *inst, void *packet)
 
 	buf->flags |= flags;
 
+	if (inst->domain == DECODER && buf->type == BUF_OUTPUT && filled_len &&
+	    inst->core->iris_platform_data->legacy_vpu5 && !seek_was_pending &&
+	    !(hfi_flags & (HFI_BUFFERFLAG_DATACORRUPT |
+			    HFI_BUFFERFLAG_DROP_FRAME))) {
+		ret = iris_vdec_hold_output(inst, buf);
+		if (ret)
+			goto error;
+		return;
+	}
+
 	iris_vb2_buffer_done(inst, buf);
 
 	return;
